<Window x:Class="WPF_Garage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WPF_Garage.MVVM"
        xmlns:userControl="clr-namespace:WPF_Garage.Views.UserControls"
        Title="Garage" Height="700" Width="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Liste des véhicules -->
        <userControl:ListeVehiculesControl />

        <!-- Panneau d'informations à droite -->
        <Expander Grid.Column="1" Background="#E5E5E5" ExpandDirection="Right" Margin="0,15"
                  HorizontalAlignment="Right" VerticalAlignment="Stretch">
            <Expander.Style>
                <Style TargetType="Expander">
                    <Setter Property="Width" Value="40"/>
                    <!-- Largeur fermée (Header uniquement) -->
                    <Style.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter Property="Width" Value="350"/>
                            <!-- Largeur déployée -->
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Expander.Style>

            <userControl:VehiculeDetailsControl ValidateButtonText="Modifier" EditableVehicule="{Binding EditableVehicule}" />
        </Expander>
    </Grid>
</Window>