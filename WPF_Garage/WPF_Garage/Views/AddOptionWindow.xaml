<Window x:Class="WPF_Garage.Views.AddOptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Garage.Views"
        mc:Ignorable="d"
        Title="AddOptionWindow" Height="350" Width="300">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Sélectionnez les options à ajouter :" Margin="0,0,0,10"/>
            <ListBox x:Name="OptionsListBox" SelectionMode="Extended" Height="180" DisplayMemberPath="Nom" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Annuler" Click="Cancel_Click" Margin="0,0,10,0"/>
                <Button Content="Ajouter" Click="Add_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
