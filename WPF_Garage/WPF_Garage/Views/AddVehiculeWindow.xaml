<Window x:Class="WPF_Garage.Views.AddVehiculeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Garage.Views"
        xmlns:userControl="clr-namespace:WPF_Garage.Views.UserControls"
        mc:Ignorable="d"
        Title="AddVehiculeWindow" Width="390" Height="730">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="20">
            <TextBlock Text="Liste des véhicules disponibles :" Margin="0,0,0,10"/>
            <DataGrid Name="spVehicules" ItemsSource="{Binding ExistingVehicules}" AutoGenerateColumns="False" IsReadOnly="True" AlternationCount="2"
                      SelectedItem="{Binding SelectedVehicule, Mode=TwoWay}"  SelectionMode="Single" Margin="0,10,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="100"/>
                    <DataGridTextColumn Header="Marque" Binding="{Binding Marque}" Width="100"/>
                    <DataGridTextColumn Header="Prix véhicule" Binding="{Binding Prix}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <userControl:VehiculeDetailsControl ValidateButtonText="Ajouter" EditableVehicule="{Binding EditableVehicule}" Grid.Row="1"/>
    </Grid>
</Window>
