<UserControl x:Class="WPF_Garage.Views.UserControls.VehiculeDetailsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF_Garage.Views.UserControls"
             xmlns:serv="clr-namespace:WPF_Garage.Services"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors">
    <Grid>
        <StackPanel Margin="15" Visibility="{Binding EditableVehicule, Converter={StaticResource NullToVisibilityConverter}}" >
            <TextBlock Text="Informations du véhicule :" FontWeight="Bold" FontSize="14"/>
            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="{Binding EditableVehicule.Nom, StringFormat=Modèle : {0}}"/>
                <TextBlock Text="{Binding EditableVehicule.Marque, StringFormat=Marque : {0}}"/>
                <TextBlock Text="{Binding EditableVehicule.Prix, StringFormat=Prix du véhicule : {0}}"/>
            </StackPanel>

            <TextBlock Text="Informations du moteur :" FontWeight="Bold" FontSize="14" Margin="0,15,0,0"/>
            <GroupBox Header="Type du moteur :" Margin="0,5,0,0">
                <ListBox ItemsSource="{Binding TypesMoteur}" Height="80"
         SelectedItem="{Binding EditableVehicule.MoteurType, Mode=TwoWay}" />
            </GroupBox>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock Text="Cylindre du moteur :" VerticalAlignment="Center"/>
                <TextBox Text="{Binding EditableVehicule.Cylindre}" Width="100" Margin="5,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock Text="Prix du moteur :" VerticalAlignment="Center"/>
                <TextBox Text="{Binding EditableVehicule.PrixMoteur}" Width="100" Margin="5,0,0,0"/>
            </StackPanel>

            <TextBlock Text="Liste des options :" FontWeight="Bold" FontSize="14" Margin="0,15,0,0"/>
            <Button Content="+" Width="25" Height="25" Margin="-20,-20,0,0" Command="{Binding AddOptionCommand}"/>
            <DataGrid ItemsSource="{Binding EditableVehicule.Options}" SelectionMode="Extended" SelectionUnit="FullRow"
              AutoGenerateColumns="False" IsReadOnly="True" Height="100" Margin="0,5,0,0">
                <i:Interaction.Behaviors>
                    <serv:DataGridSelectedItemsBehavior SelectedItems="{Binding SelectedOptions, Mode=TwoWay}" />
                </i:Interaction.Behaviors>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nom :" Binding="{Binding Nom}" Width="*"/>
                    <DataGridTextColumn Header="Prix :" Binding="{Binding Prix}" Width="*"/>
                </DataGrid.Columns>

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Supprimer" Command="{Binding DeleteOptionsCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <TextBlock Text="{Binding EditableVehicule.PrixTotal, StringFormat=Total prix : {0}}" FontWeight="Bold" FontSize="16" Margin="0,15,0,0"/>
            <Button Name="btnValidate" Content="{Binding ValidateButtonText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Background="Yellow" FontWeight="Bold" FontSize="16" Margin="0,10,0,0" Height="40" Command="{Binding EditVehiculeCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
